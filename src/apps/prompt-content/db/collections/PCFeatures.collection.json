{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": ["featureId", "name", "createdAt"],
      "properties": {
        "featureId": {"bsonType": "string"},
        "name": {"bsonType": "string"},
        "description": {"bsonType": "string"},
        "createdAt": {"bsonType": "date"}
      }
    }
  }
}