{
  "server": "mcp://newdomain",
  "auth": { "type": "oauth2", "token_url": "https://auth.promptsales.com/oauth/token" },
  "tools": [
    {
      "name": "newdomain_action",
      "input_schema": {
        "type": "object",
        "properties": { "resource_id": { "type": "string" } },
